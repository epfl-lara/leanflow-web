FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3 python3-venv ripgrep nodejs npm xz-utils zstd \
    build-essential libgmp-dev libssl-dev bubblewrap \
 && rm -rf /var/lib/apt/lists/*
ENV ELAN_HOME=/opt/elan
RUN curl --proto '=https' --tlsv1.2 -sSf https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
    | sh -s -- -y --no-modify-path --default-toolchain none
# Independent, pinned environments make MCP startup network independent.
RUN python3 -m venv /opt/lean-lsp-mcp \
 && /opt/lean-lsp-mcp/bin/pip install --no-cache-dir 'lean-lsp-mcp==0.31.0' \
 && python3 -m venv /opt/lean-explore \
 && /opt/lean-explore/bin/pip install --no-cache-dir 'lean-explore==1.3.0' \
 && python3 -m venv /opt/tools \
 && /opt/tools/bin/pip install --no-cache-dir 'uv==0.13.0' \
 && ln -s /opt/lean-lsp-mcp/bin/lean-lsp-mcp /opt/tools/bin/lean-lsp-mcp \
 && ln -s /opt/lean-explore/bin/lean-explore /opt/tools/bin/lean-explore
ARG LEMEX_RUNTIME_DIR=.runtime/lemex
COPY ${LEMEX_RUNTIME_DIR} /opt/lemex
COPY deploy/worker-entrypoint /usr/local/bin/worker-entrypoint
ENV PATH=/opt/lemex/bin:/opt/lemex/codex-path:/opt/elan/bin:/opt/tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV HOME=/home/worker LEMEX_HOME=/home/worker/.lemex ELAN_HOME=/home/worker/.elan
RUN chmod 755 /usr/local/bin/worker-entrypoint \
 && /opt/lemex/bin/lemex --version \
 && /opt/elan/bin/elan --version \
 && /opt/tools/bin/lean-lsp-mcp --help \
 && /opt/tools/bin/lean-explore --help
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/worker-entrypoint"]
