# LeanFlow Web server configuration. Copy to .env and keep it private.
# npm start and npm run dev do not load this file automatically.
# Explicit loading: node --env-file=.env server/studio.mjs
# For the supplied systemd service, use .data/server.env instead.
HOST=127.0.0.1
PORT=8090

# Set your Lemex RCP provider credentials and HTTPS API base URL.
# A new installation can leave these empty to run without assistant inference.
# Empty values do not erase credentials previously saved in .data/provider.json.
LEMEX_API_KEY=
LEMEX_BASE_URL=

# Optional: override the DeepSeek-V4.1-Flash default for this server.
# STUDIO_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Override the packaged Lemex config and catalog (falls back to ~/.lemex).
# LEMEX_HOME=/path/to/lemex

# Optional: use an absolute path for a data directory outside the checkout.
# STUDIO_DATA_DIR=/path/to/private/leanflow-web-data

# Set this to the external origin when using an HTTPS reverse proxy.
# STUDIO_ORIGIN=https://lean.example.org

# Optional: a compatible LeanExplore HTTP search endpoint hosted locally.
# Leave unset for hosted search. This is separate from opening local sources.
# STUDIO_LEANEXPLORE_URL=http://127.0.0.1:8000/api/v2/search

# Small-server defaults. Adjust these together for the deployment's hardware.
# STUDIO_MAX_WORKERS=6
# STUDIO_MAX_WORKER_QUEUE=24
# STUDIO_MAX_EDITORS=4
# STUDIO_MAX_EDITORS_PER_PROJECT=2
# STUDIO_MAX_AGENTS=2
# STUDIO_MAX_AGENT_QUEUE=12
# STUDIO_MAX_SEARCHES=4
# STUDIO_WORKER_CPUS=2
# STUDIO_WORKER_MEMORY=4g
# LEMEX_WORKER_IMAGE=lemex-web-worker:local
